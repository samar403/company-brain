# ── Claude (required for real extraction, answers and guide writing) ──────────
# Without it the app runs in offline mode with simple heuristics.
ANTHROPIC_API_KEY=
# Optional: override the model (default: claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5

# ── Storage ──────────────────────────────────────────────────────────────────
# SQLite file; defaults to ./data/brain.db. Put it on a persistent volume in production.
# DATABASE_PATH=/var/lib/company-brain/brain.db

# ── Demo mode ────────────────────────────────────────────────────────────────
# true = a fresh install creates demo@companybrain.dev / brain-demo-2026 and loads
# the fictional Northwind Labs workspace. Turn off for real deployments.
DEMO_MODE=true

# ── Slack ────────────────────────────────────────────────────────────────────
# Bot token with channels:history, channels:read, users:read (groups:* for private channels)
SLACK_BOT_TOKEN=
# Enables the Events API webhook at /api/webhooks/slack
SLACK_SIGNING_SECRET=

# ── Email ────────────────────────────────────────────────────────────────────
# Enables the inbound email webhook at /api/webhooks/email?secret=...
EMAIL_WEBHOOK_SECRET=

# Set to true only when serving over plain HTTP outside localhost (not recommended)
# INSECURE_COOKIES=false
